            <ResourceDictionary.ThemeDictionaries>
                <!-- Light Theme Asset -->
                <ResourceDictionary x:Key="Light">
                    <WindowIcon x:Key="ThemeAwareIcon">/Resources/icon-light.ico</WindowIcon>
                </ResourceDictionary>
                
                <!-- Dark Theme Asset -->
                <ResourceDictionary x:Key="Dark">
                    <WindowIcon x:Key="ThemeAwareIcon">/Resources/icon.ico</WindowIcon>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon
                Icon="avares://AutoLogout/Resources/icon-light.ico"
                ToolTipText="AutoLogout"
                Clicked="ShowMainWindow">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show AutoLogout" Click="ShowMainWindow" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>