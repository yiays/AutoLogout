<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoLogout"
        x:Class="AutoLogout.PromptDialog"
        x:DataType="local:PromptDialog"
        Title="{Binding Caption}"
        Width="350"
        Height="200"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <StackPanel Margin="12">
        <TextBlock Text="{Binding Text}" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <TextBox Text="{Binding Input}" Width="300" Margin="0,0,0,10" PasswordChar="{Binding Sensitive}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="Ok" Margin="5" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>

</Window>