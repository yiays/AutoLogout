<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoLogout.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="144"
        x:Class="AutoLogout.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Time limit"
        WindowStartupLocation="Manual"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="False"
        SystemDecorations="None">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel>
        <TextBlock x:Name="textTimer" Text="{Binding TimeDisplay}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="PauseButton" Content="Pause" Margin="5" />
            <Button x:Name="LogoffButton" Content="Logoff" Margin="5" Width="32" Height="32" />
            <Button x:Name="ShutdownButton" Content="Shutdown" Margin="5" Width="32" Height="32" />
            <Button x:Name="SettingsButton" Content="Settings" Margin="5" Width="32" Height="32" />
        </StackPanel>
    </StackPanel>

</Window>