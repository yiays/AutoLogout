<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoLogout"
        x:Class="AutoLogout.PromptDialog"
        x:DataType="local:PromptDialog"
        Title="{Binding Caption}"
        Icon="{DynamicResource ThemeAwareIcon}"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Focusable="True">

    <StackPanel Margin="12">
        <TextBlock Text="{Binding Text}" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <TextBox x:Name="InputTextBox" Text="{Binding Input}" Width="340" Margin="0,0,0,10" PasswordChar="{Binding Sensitive}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="Ok" Margin="0,0,5,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Margin="0" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>