<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoLogout"
        x:Class="AutoLogout.ControlPanel"
        x:DataType="local:ControlPanel"
        Title="AutoLogout Settings"
        Icon="{DynamicResource ThemeAwareIcon}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <StackPanel Margin="5" Spacing="10">
        
        <local:UpdateNotice Margin="-5"/>

        <TabControl x:Name="tabControl" Margin="0,-10,0,0" MinHeight="300">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="20"/>
                </Style>
                <!-- Hides only the visual header button for this class -->
                <Style Selector="TabItem.hidden-tab">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
            </TabControl.Styles>
            <TabItem x:Name="TabLimits" Header="Limits">
                <StackPanel Spacing="5">
                    <TextBlock TextWrapping="Wrap">
                        You can change time limits and downtime for this account here.
                    </TextBlock>
                    <GroupBox Header="Today">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="12" Foreground="Gray">These settings reset each day.</TextBlock>
                            <Grid RowDefinitions="24,1,24" ColumnDefinitions="120,*" RowSpacing="8">
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Used time:"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" Text="{Binding UsedTime_Formatted}"/>

                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Maximum="{Binding MaxTime}" Value="{Binding UsedTime}" Margin="0,-10,0,4" Foreground="{Binding ExceededTime_Colour}" />
    
                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Time limit:"/>
                                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                                    <NumericUpDown Value="{Binding TodayLimit}" Minimum="-1" Maximum="1440"/>
                                    <TextBlock Text="minutes"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Daily">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="12" Foreground="Gray">These settings apply every day.</TextBlock>
                            <Grid RowDefinitions="24,24,24" ColumnDefinitions="120,*" RowSpacing="8">
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Time limit:"/>
                                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                                    <NumericUpDown Value="{Binding DailyLimit}" Minimum="-1" Maximum="1440"/>
                                    <TextBlock Text="minutes"/>
                                </StackPanel>

                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Downtime start:"/>
                                <TimePicker Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" SelectedTime="{Binding Bedtime}"/>

                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Downtime end:"/>
                                <TimePicker Grid.Column="1" Grid.Row="2" HorizontalAlignment="Right" SelectedTime="{Binding Waketime}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="TabUsage" Header="Usage">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Content="Previous" Click="PrevDayUsage_Click" IsEnabled="{Binding GraphPrevAvailable}"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding GraphDate}"/>
                        <Button Grid.Column="2" HorizontalAlignment="Right" Content="Next" Click="NextDayUsage_Click" IsEnabled="{Binding GraphNextAvailable}"/>
                    </Grid>
                    <TextBlock Text="{Binding DateUsage_Formatted}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12">
                        Hover over apps to see examples of content that was open in this app.
                    </TextBlock>
                    <ScrollViewer MaxHeight="220">
                        <ItemsControl ItemsSource="{Binding UsageGraph}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="24,*,40" RowDefinitions="24,8" ColumnSpacing="8" RowSpacing="8" Margin="8"  ToolTip.Tip="{Binding windowNames}">
                                        <Image Source="{Binding icon}" Width="24" Height="24"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding displayName}"/>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding usedTimeFormatted}"/>
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Maximum="{Binding $parent[Window].DataContext.GraphMax}" Value="{Binding usedTime}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Dotted border -->
                    <Grid IsVisible="{Binding GraphEmpty}">
                        <Rectangle Stroke="Gray" StrokeThickness="2" StrokeDashArray="1,2" RadiusX="2" RadiusY="2" Fill="Transparent"/>
                        <TextBlock Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            No usage data for this date!
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="TabSync" Header="Sync">
                <StackPanel Spacing="5">
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#9296d2" Offset="0.0"/>
                                <GradientStop Color="#e0d8e2" Offset="0.5"/>
                                <GradientStop Color="#9296d2" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="Auto,*" Margin="5">
                            <Image Source="avares://AutoLogout/Resources/mobile-header.png" Width="360" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                    <TextBlock TextWrapping="Wrap">
                        You can connect AutoLogout to your phone with the AutoLogout Manager app and change settings remotely.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12">
                        This will sync some data over the internet.
                    </TextBlock>
                    <HyperlinkButton NavigateUri="https://autologout.yiays.com/legal/#autologout-for-windows" FontSize="12" Background="#eee">
                        Privacy policy
                    </HyperlinkButton>
                    <Button x:Name="AuthButton" Background="#9296d2" Foreground="White" Margin="0,10,0,0" Click="AuthButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource PhoneIcon}" Width="16" Height="16" />
                            <TextBlock Text="Connect AutoLogout to your phone" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeauthButton" IsEnabled="{Binding Online}" Content="Disconnect all devices" Click="DeauthButton_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="TabSystem" Header="System">
                <StackPanel Spacing="5">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        These settings require Administrator permissions to change.
                    </TextBlock>
                    <CheckBox Content="Start automatically on login" IsChecked="{Binding AutoStart}" IsCheckedChanged="AutoStart_Checked" />
                    <Button x:Name="RemoveControlsButton" Background="#df4d28" Foreground="White" Click="RemoveControls_Click">
                        Remove AutoLogout from this account
                    </Button>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="TabQR" Classes="hidden-tab">
                <StackPanel Spacing="5">
                    <TextBlock TextWrapping="Wrap">
                        Scan the QR code below to manage this account with your phone.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12">
                        If you haven't installed AutoLogout Manager, you may need to scan it twice.
                    </TextBlock>
                    <Grid Width="230" Height="230">
                        <Image x:Name="ImageQRCode" Width="230" Height="230"
                            RenderOptions.BitmapInterpolationMode="None" />
                        <Image Source="avares://AutoLogout/Resources/qr-overlay.png" Width="80" Height="80" />
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
            <Button x:Name="ChangePasswordButton" Background="#eee" Foreground="Black" Click="ChangePassword_Click">
                Change parent password
            </Button>
            <Button Grid.Column="1" x:Name="SaveButton" Content="Save" IsDefault="True" Click="SaveButton_Click"/>
            <Button Grid.Column="2" x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"/>
        </Grid>
    </StackPanel>
</Window>