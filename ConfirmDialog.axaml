<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoLogout"
        x:Class="AutoLogout.ConfirmDialog"
        x:DataType="local:ConfirmDialog"
        Title="{Binding Caption}"
        Width="240"
        Height="124"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <StackPanel Margin="12">
        <TextBlock Text="{Binding Text}" Margin="0,0,0,10" Height="64" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton" Content="Yes" Margin="0,0,5,0" Click="ConfirmButton_Click"/>
            <Button x:Name="CancelButton" Content="No" Margin="0" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>